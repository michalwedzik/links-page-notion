---
import links from "../data/links.json";

const activeLinks = links.filter((link) => link.active);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Michał Wędzik</title>
    <meta
      name="description"
      content="Michał Wędzik - Senior Java Developer"
    />
  </head>

  <body>
    <main class="container">
      <header class="profile">
        <div class="avatar">MW</div>

        <h1>Michał Wędzik</h1>

        <p>Senior Java Developer</p>
      </header>

      <section class="links">
        {
          activeLinks.map((link) => (
            <a
              class="link"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.icon && <span class="icon">{link.icon}</span>}

              <span class="link-content">
                <strong>{link.name}</strong>
                {link.text && <small>{link.text}</small>}
              </span>

              <span class="arrow">→</span>
            </a>
          ))
        }
      </section>

      <footer>
        <span>© {new Date().getFullYear()} Michał Wędzik</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    font-family:
      Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f5f5f5;
    color: #111;
  }

  .container {
    width: min(100% - 32px, 680px);
    margin: 0 auto;
    padding: 64px 0 32px;
  }

  .profile {
    text-align: center;
    margin-bottom: 40px;
  }

  .avatar {
    width: 96px;
    height: 96px;
    margin: 0 auto 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    background: #111;
    color: white;

    font-size: 28px;
    font-weight: 700;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 28px;
    line-height: 1.2;
  }

  .profile p {
    margin: 0;
    color: #666;
    font-size: 16px;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .link {
    position: relative;

    display: flex;
    align-items: center;

    min-height: 68px;
    padding: 12px 20px;

    border: 1px solid #ddd;
    border-radius: 14px;

    background: white;
    color: inherit;
    text-decoration: none;

    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgb(0 0 0 / 8%);
  }

  .icon {
    width: 36px;
    margin-right: 12px;

    text-align: center;
    font-size: 22px;
  }

  .link-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .link-content strong {
    font-size: 16px;
  }

  .link-content small {
    color: #777;
    font-size: 13px;
  }

  .arrow {
    margin-left: auto;
    color: #999;
    font-size: 20px;
  }

  footer {
    margin-top: 48px;
    text-align: center;
    color: #999;
    font-size: 13px;
  }

  @media (max-width: 600px) {
    .container {
      padding-top: 40px;
    }

    h1 {
      font-size: 24px;
    }
  }
</style>